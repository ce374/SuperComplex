<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme overrides: same color names as values/colors.xml,
         overridden for night UI mode. Per Android resource rules, every
         color declared in values-night must also exist in the base
         values folder, so we re-declare each name with the dark value. -->
    <color name="bg_primary">#16161A</color>
    <color name="bg_card">#1F1F25</color>
    <color name="bg_image_ph">#2A2A30</color>
    <color name="text_primary">#F5F1EA</color>
    <color name="text_muted">#6E6A60</color>
    <color name="text_on_card">#F5F1EA</color>
    <color name="divider">#2A2A30</color>
    <color name="accent">#E07070</color>
    <color name="chip_bg">#2A2A30</color>
    <color name="chip_bg_selected">#F5F1EA</color>
    <color name="chip_text">#F5F1EA</color>
    <color name="chip_text_selected">#16161A</color>
    <color name="nav_tint">#6E6A60</color>
    <color name="nav_tint_selected">#F5F1EA</color>
    <color name="overlay_channel">#80000000</color>
    <color name="progress_track">#2A2A30</color>
</resources>
