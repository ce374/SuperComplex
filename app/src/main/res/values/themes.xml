<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      SuperComplex theme.
      Intentionally NOT a MaterialComponents theme - the user requested
      "no Material UI". Inherits from a plain AppCompat theme and defines
      its own minimalist palette.
    -->
    <style name="Theme.SuperComplex" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg_primary</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/bg_card</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="NavBarItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="NavBarText">
        <item name="android:textSize">10sp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/nav_tint_selector</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
